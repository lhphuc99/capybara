{
  "name": "@capybara-devtools/protocol",
  "version": "0.4.0",
  "description": "Wire protocol, and helpers to read its values, shared by the Capybara SDKs, server and UI",
  "keywords": [
    "capybara"
  ],
  "homepage": "https://github.com/lhphuc99/capybara#readme",
  "bugs": "https://github.com/lhphuc99/capybara/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhphuc99/capybara.git",
    "directory": "packages/protocol"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
