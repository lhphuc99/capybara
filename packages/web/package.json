{
  "name": "@capybara-devtools/web",
  "version": "0.6.0",
  "description": "Browser SDK for Capybara: logs, network and storage for React, Vite and Next.js apps",
  "keywords": [
    "capybara",
    "devtools",
    "debugger",
    "logs",
    "network",
    "localstorage",
    "react",
    "vite",
    "nextjs"
  ],
  "homepage": "https://github.com/lhphuc99/capybara#readme",
  "bugs": "https://github.com/lhphuc99/capybara/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhphuc99/capybara.git",
    "directory": "packages/web"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@capybara-devtools/core": "0.6.0",
    "@capybara-devtools/protocol": "0.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
