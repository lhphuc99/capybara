{
  "name": "@capybara-devtools/react-native",
  "version": "0.5.1",
  "description": "React Native SDK for Capybara: logs, network and storage for React Native and Expo apps",
  "keywords": [
    "capybara",
    "react-native",
    "expo",
    "devtools",
    "debugger",
    "logs",
    "network",
    "asyncstorage",
    "mmkv"
  ],
  "homepage": "https://github.com/lhphuc99/capybara#readme",
  "bugs": "https://github.com/lhphuc99/capybara/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhphuc99/capybara.git",
    "directory": "packages/react-native"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@capybara-devtools/core": "0.5.1",
    "@capybara-devtools/protocol": "0.5.1"
  },
  "peerDependencies": {
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "react-native": "0.86.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
