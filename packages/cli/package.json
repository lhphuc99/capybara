{
  "name": "capybara-devtools",
  "version": "0.6.1",
  "description": "Debug React Native and web apps: logs, network and storage in a local UI",
  "keywords": [
    "devtools",
    "debugger",
    "react-native",
    "expo",
    "react",
    "nextjs",
    "logs",
    "network",
    "websocket",
    "storage",
    "mmkv",
    "asyncstorage",
    "mcp"
  ],
  "homepage": "https://github.com/lhphuc99/capybara#readme",
  "bugs": "https://github.com/lhphuc99/capybara/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhphuc99/capybara.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "capybara": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/copy-ui.mjs",
    "prepack": "node scripts/check-package.mjs",
    "dev": "tsc -b --watch",
    "start": "node dist/bin.js",
    "test": "vitest run",
    "test:mmkv-compat": "node scripts/check-mmkv-compat.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@capybara-devtools/core": "0.6.1",
    "@capybara-devtools/protocol": "0.6.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
