{
  "name": "@capybara-devtools/core",
  "version": "0.5.0",
  "description": "Client runtime and built-in plugins for Capybara",
  "keywords": [
    "capybara",
    "devtools",
    "debugger"
  ],
  "homepage": "https://github.com/lhphuc99/capybara#readme",
  "bugs": "https://github.com/lhphuc99/capybara/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhphuc99/capybara.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@capybara-devtools/protocol": "0.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/query-core": "^5.104.4",
    "mobx": "^7.0.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "redux": "^5.0.1",
    "swr": "^2.5.1",
    "xstate": "^5.33.2",
    "zustand": "^5.0.15"
  }
}
