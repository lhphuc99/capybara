# Expo
.expo/
examples/expo/ios/
examples/expo/android/

# Dart and Flutter. Only under dart/: a bare build/ would also hide apps/desktop/build/, which holds the icons.
# The workspace's pubspec.lock is left out because it resolves packages, which CI checks on every Flutter version.
dart/**/.dart_tool/
dart/**/build/
dart/**/.flutter-plugins*
dart/pubspec.lock

# Desktop app packages (electron-builder)
apps/desktop/release/

# Notes for the GitHub release, written by `npm run desktop:release`
apps/desktop/release-notes.md

# Working plans for features, kept locally
plans/
