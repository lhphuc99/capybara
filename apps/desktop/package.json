{
  "name": "@capybara-devtools/desktop",
  "productName": "Capybara",
  "desktopName": "capybara-desktop.desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Capybara as a desktop app: the server and the UI in one window",
  "author": "Capybara",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder --mac --win --linux",
    "release": "node -e \"if (!process.env.GH_TOKEN) { console.error('Set GH_TOKEN to a GitHub token that can write to lhphuc99/capybara (docs/RELEASING.md).'); process.exit(1) }\" && npm run build && node ../../scripts/release-notes.mjs > release-notes.md && electron-builder --mac --win --linux --publish always",
    "icon": "node scripts/icon.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@capybara-devtools/protocol": "0.1.0",
    "@types/ws": "^8.18.2",
    "capybara-devtools": "0.1.0",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "rolldown": "^1.2.14",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "dev.capybara.desktop",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "lhphuc99",
      "repo": "capybara",
      "releaseType": "draft",
      "publishAutoUpdate": false
    },
    "npmRebuild": false,
    "toolsets": {
      "appimage": "1.0.3"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icon",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "executableName": "capybara-desktop",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Debug React Native and web apps: logs, network and storage"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
